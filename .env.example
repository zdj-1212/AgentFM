# ============================================================
# AgentFM 环境变量示例
# 复制本文件为 .env 并修改为你的实际配置：
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 注意：docker-compose.yml 也会读取这个 .env——它用 MYSQL_PASSWORD / MYSQL_DATABASE
# 来初始化 MySQL 容器，让容器与应用的连接参数天然一致，不需要在两处各配一遍。
# 所以请先建好 .env，再执行 docker compose up -d。
#
# 同名环境变量可以覆盖本文件（优先级：环境变量 > .env > config/settings.py 的默认值）。
# ============================================================

# ---------- 应用基础 ----------
APP_NAME=AgentFM
DEBUG=false

# ---------- MySQL（本地默认：127.0.0.1:3306, root/123456）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agentfm

# ---------- Redis（可选加速层，没有也能跑）----------
# 用途只有两处，且都是"拿不到就退化"的：
#   1) 认证限流计数 → 放 Redis 后多进程/重启后依然一致（默认走进程内存）
#   2) 检索结果缓存 → 同一个问句复用 embedding 与向量检索结果，省一次外部调用
# 不装 Redis 也没关系：限流退回进程内、检索不走缓存，功能不受影响。
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 你的 Redis 有密码就必须填在这里。留空的话连不上，程序会静默退化成"没有 Redis"，
# 表现为日志里一句"Redis 不可用"，而不是报错——所以启用后请确认没看到那句警告。
REDIS_PASSWORD=
REDIS_DB=0
# key 前缀：与同一个 Redis 上别人的数据隔离（比切 DB 通用，Redis Cluster 也适用）
REDIS_KEY_PREFIX=agentfm:
# 检索缓存有效期（秒）。知识库重新入库时会主动清缓存，这里只是兜底上限。
RETRIEVE_CACHE_TTL_SECONDS=600

# ---------- Milvus（本地默认：http://127.0.0.1:19530）----------
MILVUS_URI=http://127.0.0.1:19530
# 向量集合名
MILVUS_COLLECTION=agentfm_knowledge
# 向量维度：必须与所选择的 Embedding 模型输出维度一致
#   BAAI/bge-small-zh-v1.5 -> 512
#   BAAI/bge-m3            -> 1024
#   text-embedding-v3      -> 1024
EMBEDDING_DIM=1024

# ---------- 大模型 LLM ----------
# 提供方：openai_compatible（OpenAI 兼容接口，可对接通义/DeepSeek/Ollama/vLLM 等）

LLM_PROVIDER=openai_compatible
# 兼容接口地址示例：
#   通义千问(DashScope):  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek:            https://api.deepseek.com/v1
#   Ollama(本地):        http://localhost:11434/v1
#   本地 vLLM:           http://localhost:8000/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxx
# 模型名示例：qwen-plus / qwen-turbo / deepseek-chat / qwen2.5:7b
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# 单次调用的超时与重试。千万不要留空：不设置会退化成 openai SDK 的默认值
# （读超时 600 秒 + 2 次重试），一次卡住的调用足以把用户的请求挂住十几分钟。
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ---------- Embedding 向量化 ----------
# 模式：api （OpenAI 兼容 /embeddings 接口，如通义 text-embedding-v3）
EMBEDDING_MODE=api
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_API_MODEL=text-embedding-v3
CHECK_EMBEDDING_CTX_LENGTH=false
# 向量化超时与重试（同理，不设会吃 600 秒的 SDK 默认值）
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1

# ---------- 检索参数 ----------
RETRIEVE_TOP_K=4
# 相似度阈值（余弦相似度，越大越相关），低于阈值的结果会被丢弃，防止答非所问
RETRIEVE_SCORE_THRESHOLD=0.45

# ---------- 对话记忆 ----------
# 每轮问答携带最近几轮的历史消息作为上下文
HISTORY_WINDOW=6

# ---------- 用户认证 ----------
# 登录令牌的签名密钥（HMAC-SHA256）。
# 生产环境请务必改成随机长字符串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 泄露该值等于任何人都能伪造任意用户的登录令牌。
AUTH_SECRET_KEY=agentfm-dev-secret-change-me
# 登录令牌有效期（小时）
AUTH_TOKEN_TTL_HOURS=72
# 注册时的最小密码长度
PASSWORD_MIN_LENGTH=6

# ---------- 认证限流 ----------
# 登录/注册都要跑一次昂贵的口令哈希（argon2id，单次约占 64MiB 内存），
# 不限流则既是撞库入口也是纯 CPU 的 DoS 面。
# 配了 Redis 则计数全局一致（多进程/重启都算数）；没有 Redis 时退回进程内，
# 此时多 worker 各算各的，严格限流请再在网关层加一道。
AUTH_RATE_LIMIT_ENABLED=true
# 同一来源每分钟的认证尝试上限（不论成败）
AUTH_RATE_LIMIT_IP_PER_MINUTE=20
# 同一账号在窗口内的失败次数上限（成功不计入）
AUTH_RATE_LIMIT_USER_FAILURES=5
# 上一条的统计窗口（秒）
AUTH_RATE_LIMIT_USER_WINDOW_SECONDS=300
# 是否信任 X-Forwarded-For 里的客户端 IP。
# 只有在"请求必然经过可信反向代理、且代理会覆写该头"时才可开启：
# XFF 是客户端能自己伪造的，贸然信任等于给攻击者一把绕过限流的钥匙。
TRUST_PROXY_HEADERS=false

# ---------- 会话标题 ----------
# 是否用大模型把"首轮提问"概括成会话标题（更短更可读）
# 关闭后直接截断问句作为标题，可省一次 LLM 调用
TITLE_AUTO_SUMMARY=true
# 标题最大字数
TITLE_MAX_CHARS=20
