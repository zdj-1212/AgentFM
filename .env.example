# ============================================================
# AgentFM 环境变量示例
# 复制本文件为 .env 并修改为你的实际配置：
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ============================================================

# ---------- 应用基础 ----------
APP_NAME=AgentFM
DEBUG=false

# ---------- MySQL（本地默认：127.0.0.1:3306, root/123456）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agentfm

# ---------- Milvus（本地默认：http://127.0.0.1:19530）----------
MILVUS_URI=http://127.0.0.1:19530
# 向量集合名
MILVUS_COLLECTION=agentfm_knowledge
# 向量维度：必须与所选择的 Embedding 模型输出维度一致
#   BAAI/bge-small-zh-v1.5 -> 512
#   BAAI/bge-m3            -> 1024
#   text-embedding-v3      -> 1024
EMBEDDING_DIM=1024

# ---------- 大模型 LLM ----------
# 提供方：openai_compatible（OpenAI 兼容接口，可对接通义/DeepSeek/Ollama/vLLM 等）

LLM_PROVIDER=openai_compatible
# 兼容接口地址示例：
#   通义千问(DashScope):  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek:            https://api.deepseek.com/v1
#   Ollama(本地):        http://localhost:11434/v1
#   本地 vLLM:           http://localhost:8000/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxx
# 模型名示例：qwen-plus / qwen-turbo / deepseek-chat / qwen2.5:7b
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---------- Embedding 向量化 ----------
# 模式：api （OpenAI 兼容 /embeddings 接口，如通义 text-embedding-v3）
EMBEDDING_MODE=api
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_API_MODEL=text-embedding-v3
CHECK_EMBEDDING_CTX_LENGTH=false

# ---------- 检索参数 ----------
RETRIEVE_TOP_K=4
# 相似度阈值（余弦相似度，越大越相关），低于阈值的结果会被丢弃，防止答非所问
RETRIEVE_SCORE_THRESHOLD=0.45

# ---------- 对话记忆 ----------
# 每轮问答携带最近几轮的历史消息作为上下文
HISTORY_WINDOW=6
